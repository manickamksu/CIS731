{
  "name": "CIS 731 MP 9 (CPU)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bullseye",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    }
  },
  "containerEnv": {
    "CUDA_VISIBLE_DEVICES": "",
    "TOKENIZERS_PARALLELISM": "false"
  },
  "postCreateCommand": "pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt"
}
