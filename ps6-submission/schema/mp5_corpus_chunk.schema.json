{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cis731.example/ps6/schema/mp5_corpus_chunk.schema.json",
  "title": "MP5 CorpusChunk (base record, VDB track)",
  "description": "JSON Schema rendering of the MP 5 CorpusChunk StructType. Keep the nullability here identical to your MP 5 submission; PS 6 extends this record and must not change it.",
  "type": "object",
  "required": ["record_id", "track", "source_id", "text", "ingest_ts", "license_class"],
  "properties": {
    "record_id":     { "type": "string", "minLength": 1 },
    "track":         { "const": "VDB" },
    "source_id":     { "type": "string", "minLength": 1 },
    "ts_start":      { "type": ["number", "null"], "minimum": 0 },
    "ts_end":        { "type": ["number", "null"], "minimum": 0 },
    "text":          { "type": "string", "minLength": 1 },
    "ingest_ts":     { "type": "string", "format": "date-time" },
    "license_class": { "enum": ["public_domain", "instructor_provided"] }
  }
}
